# PostgreSQL connection string. Required.
# Neon:     postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Local:    postgresql://postgres:postgres@localhost:5432/newzen_crm
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newzen_crm

# Set to 0 to skip loading the demo dataset into an empty database.
# Leave unset (or 1) for a demo deployment; set 0 for a real one.
CRM_AUTO_SEED=1

# Seed determinism - change to regenerate a different demo dataset.
CRM_SEED=20260829

# Connections per instance. Defaults to 1 on Vercel, 10 elsewhere.
# PGPOOL_MAX=10
